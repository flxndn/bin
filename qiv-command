#!/bin/bash
### syntax: qiv-command [pushed_number] [image_filename_with_full_path]
#-------------------------------------------------------------------------------
bck(){
#-------------------------------------------------------------------------------
	file="$1"
	cp "$1" "$1.back"
}
#-------------------------------------------------------------------------------
ubck(){
#-------------------------------------------------------------------------------
	back="$1.back"
	file="$1"
	if [ -e "$back" ]; then
		tmp=$(mktemp)
		mv "$file" "$tmp"
		mv "$back" "$file"
		mv "$tmp" "$back"
	else
		echo "El fichero $2 no tiene copia de seguridad"
	fi
}
#-------------------------------------------------------------------------------
tiempo=$(date +%Y%m%d%H%M%S)
case $1 in
  0) ubck "$2";exit;;
  1) echo "$tiempo	$2	1" >> .qiv.log; exit;;
  2) echo "$tiempo	$2	2" >> .qiv.log; exit;;
  3) echo "$tiempo	$2	3" >> .qiv.log; exit;;
  4) echo "$tiempo	$2	4" >> .qiv.log; exit;;
  5) jhead "$2";exit;;
  6) gvim "$2.txt"; exit;;
  7) bck "$2"; mogrify -rotate "-90" "$2"; exit;;
  8) bck "$2"; mogrify -rotate "90" "$2"; exit;;
  9) bck "$2"; mogrify -normalize "$2"; exit;;
  *) echo "Pulse una tecla del 0 al 9"; exit ;;
esac
 

